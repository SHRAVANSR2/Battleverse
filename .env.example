# BattleVerse environment template.
# Copy to .env in the repository root and fill in values you need.
#   PowerShell:  Copy-Item .env.example .env
# NEVER commit .env. It is gitignored.

APP_ENV=development
APP_VERSION=0.1.0

# SQLite database. Relative paths resolve from the backend/ directory.
DATABASE_URL=sqlite+pysqlite:///./storage/battleverse.db

# Browser origins allowed to call the API directly (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM: Groq (primary) ---
# Get a free key at https://console.groq.com/keys
# Leave empty to run in Demo Mode (clearly labelled scripted verses, not AI).
GROQ_API_KEY=
# Current Groq production model (Oct 2026). Alternatives: openai/gpt-oss-20b
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0.9
LLM_MAX_TOKENS=320

# --- TTS: Piper (local, free, no API key) ---
# piper = real local neural TTS (default). fake = synthetic tone for tests only.
TTS_PROVIDER=piper
TTS_VOICES_DIR=./storage/models
TTS_TIMEOUT_SECONDS=60
TTS_MAX_TEXT_CHARS=800

AUDIO_STORAGE_DIR=./storage/audio

LOG_LEVEL=INFO
